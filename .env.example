APP_NAME=VenExpress
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Caracas
BCV_API_URL=https://ve.dolarapi.com/v1/dolares/oficial
BCV_MAX_RATE_AGE_HOURS=48

# Google Places Autocomplete en el formulario de "Registrar pedido" (dirección
# exacta de entrega). Requiere una cuenta de Google Cloud con facturación y
# "Maps JavaScript API" + "Places API" habilitadas. Sin esta clave, el campo
# de dirección sigue funcionando como texto libre (sin autocompletado ni
# coordenadas exactas) — GeocodingService sigue de respaldo para esos casos.
GOOGLE_MAPS_API_KEY=

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# 24 horas: personal como taquilla trabaja turnos de más de 12 horas
# y no debe perder la sesión a mitad del turno.
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# false aquí porque el entorno local corre sobre HTTP (localhost). En
# producción, donde la app se sirve por HTTPS, esto DEBE ser true —
# si no, la cookie de sesión viaja sin el flag "secure" y queda
# expuesta a robo de sesión en redes inseguras.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Documentos privados de verificación (Aliado/Repartidor) y evidencia
# de entrega — ver config/filesystems.php, disco "documents".
# "local" (por defecto) guarda todo en storage/app/private, en este
# mismo servidor. Cuando el sistema necesite no llenar el disco de la
# app, o correr en más de un servidor, cambia esto a "s3" y llena las
# credenciales AWS_* de arriba (funciona igual con DigitalOcean Spaces
# u otro proveedor compatible con S3: usa AWS_ENDPOINT para su URL y
# AWS_USE_PATH_STYLE_ENDPOINT=true). No requiere ningún otro cambio.
DOCUMENTS_DISK_DRIVER=local

VITE_APP_NAME="${APP_NAME}"
